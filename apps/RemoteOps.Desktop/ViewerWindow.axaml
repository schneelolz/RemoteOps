<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:RemoteOps.Desktop" Icon="/Assets/remoteops.ico" x:Class="RemoteOps.Desktop.ViewerWindow" Width="1080" Height="700" MinWidth="660" MinHeight="340" Background="#0B1118">
  <Grid RowDefinitions="Auto,*">
    <Border Background="{DynamicResource DeskBar}" BorderBrush="{DynamicResource DeskRule}" BorderThickness="0,0,0,1" Padding="14,8">
      <Grid Name="Toolbar" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <WrapPanel Name="ToolbarActions" Grid.Column="1" VerticalAlignment="Center">
          <ToggleSwitch Name="ClipboardShare" OnContent="共享剪贴板" OffContent="共享剪贴板" IsChecked="True"
                        AutomationProperties.Name="共享剪贴板" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <Border Width="1" Height="22" Background="{DynamicResource DeskRule}" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <Border Classes="segment-group" Margin="0,0,8,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button Name="Observe" AutomationProperties.Name="观察" Classes="tool" IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Width="15" Height="15" Data="M12 4C6.3 4 2.4 8.2 0.7 12C2.4 15.8 6.3 20 12 20C17.7 20 21.6 15.8 23.3 12C21.6 8.2 17.7 4 12 4ZM12 6C16.3 6 19.6 9.1 21.1 12C19.6 14.9 16.3 18 12 18C7.7 18 4.4 14.9 2.9 12C4.4 9.1 7.7 6 12 6ZM12 8A4 4 0 1 0 12 16A4 4 0 1 0 12 8Z" VerticalAlignment="Center"/>
                  <TextBlock Text="观察" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button Name="Control" AutomationProperties.Name="控制" Classes="tool" IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Width="15" Height="15" Data="M4 2L20 13L13.7 14L17 20.4L14 22L10.8 15.6L6.3 20Z" VerticalAlignment="Center"/>
                  <TextBlock Text="控制" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
          <Border Width="1" Height="22" Background="{DynamicResource DeskRule}" Margin="0,0,6,0" VerticalAlignment="Center"/>
          <Button Name="PictureQuality" Content="画质 · 自动" Classes="tool" AutomationProperties.Name="画质" Margin="0,0,3,0">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="自动" Tag="auto" ToggleType="Radio" IsChecked="True" Click="SelectQuality"/>
                <MenuItem Header="流畅" Tag="smooth" ToggleType="Radio" Click="SelectQuality"/>
                <MenuItem Header="均衡" Tag="balanced" ToggleType="Radio" Click="SelectQuality"/>
                <MenuItem Header="高清（文字优先）" Tag="high" ToggleType="Radio" Click="SelectQuality"/>
                <Separator/>
                <MenuItem Header="传输方式">
                  <MenuItem Header="自动（直连优先，中继优先 MiniRTC）" Name="BackendAuto" Tag="auto" ToggleType="Radio" Click="SelectBackend"/>
                  <MenuItem Header="TCP 中继" Name="BackendTcp" Tag="tcp" ToggleType="Radio" Click="SelectBackend"/>
                  <MenuItem Header="CrossDesk · 自动选择路径" Name="BackendCrossDesk" Tag="crossdesk" ToggleType="Radio" Click="SelectBackend"/>
                  <MenuItem Header="MiniRTC · TURN/UDP" Name="BackendRtc" Tag="minirtc" ToggleType="Radio" Click="SelectBackend"/>
                </MenuItem>
                <MenuItem Header="性能信息" ToggleType="CheckBox" Click="ToggleStatistics"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Name="Zoom" Content="100%" Classes="tool" Margin="0,0,3,0"/>
          <Button Name="Fullscreen" Classes="tool" AutomationProperties.Name="全屏" Margin="0,0,3,0">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="15" Height="15" Data="M3 3H10V5H5V10H3ZM14 3H21V10H19V5H14ZM3 14H5V19H10V21H3ZM19 14H21V21H14V19H19Z" VerticalAlignment="Center"/>
              <TextBlock Name="FullscreenLabel" Text="全屏" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <local:AppearanceButton Classes="tool" Margin="0,0,6,0"/>
          <Button Name="End" AutomationProperties.Name="结束共享" Classes="tool end">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="15" Height="15" Data="M5 4H19Q20 4 20 5V19Q20 20 19 20H5Q4 20 4 19V5Q4 4 5 4ZM6 6V18H18V6Z" VerticalAlignment="Center"/>
              <TextBlock Text="结束共享" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </WrapPanel>
        <Grid Name="ToolbarIdentity" ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center" Margin="0,0,12,0">
          <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource DeskAccentSoft}" VerticalAlignment="Center">
            <PathIcon Width="18" Height="18" Foreground="{DynamicResource DeskAccentInk}" Data="M2 3H22V17H13V19H17V21H7V19H11V17H2ZM4 5V15H20V5Z" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
            <TextBlock Name="NameLabel" TextTrimming="CharacterEllipsis" FontSize="15.5" FontWeight="SemiBold"/>
            <WrapPanel>
              <TextBlock Name="Mode" Margin="0,0,10,0" Text="准备本机观看组件" FontSize="12.5" Classes="muted"/>
              <TextBlock Name="Resolution" Margin="0,0,10,0" FontSize="12.5" FontFamily="Cascadia Code, Consolas, Microsoft YaHei UI" Classes="muted"/>
              <TextBlock Name="ClipboardState" Margin="0,0,10,0" FontSize="12.5" Classes="muted" IsVisible="False"/>
            </WrapPanel>
            <TextBlock Name="Route" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}" FontSize="12.5" Classes="muted"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
    <Grid Grid.Row="1">
      <ScrollViewer Name="Viewport" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" BringIntoViewOnFocusChange="False">
        <Grid Name="CanvasArea" Background="#0B1118" Focusable="True" ClipToBounds="True">
          <Image Name="Screen" Stretch="Uniform" IsHitTestVisible="False"/>
        </Grid>
      </ScrollViewer>
      <Border Name="PerformancePanel" IsVisible="False" IsHitTestVisible="False" Margin="12"
              HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#E6111827" CornerRadius="6" Padding="12,8">
        <TextBlock Name="PerformanceText" Foreground="#F8FAFC" FontSize="13" TextWrapping="Wrap"/>
      </Border>
      <Border Name="Overlay" Background="#CC111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="26,20" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
        <StackPanel Spacing="14">
          <TextBlock Name="Info" Text="正在准备本机观看组件" FontSize="15" TextAlignment="Center" TextWrapping="Wrap" Foreground="#F8FAFC"/>
          <Button Name="Retry" Classes="primary" HorizontalAlignment="Center" Content="重新打开" IsVisible="False"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
