<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:RemoteOps.Desktop" Icon="/Assets/remoteops.ico" x:Class="RemoteOps.Desktop.ViewerWindow" Width="1060" Height="690" MinWidth="660" MinHeight="320" Background="#142128">
  <Grid RowDefinitions="Auto,*">
    <Border Background="{DynamicResource DeskBar}" BorderBrush="{DynamicResource DeskRule}" BorderThickness="0,0,0,1" Padding="12,7"><Grid Name="Toolbar" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
      <WrapPanel Name="ToolbarActions" Grid.Column="1" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Margin="0,0,10,0">
          <Label Content="共享剪贴板" Target="{Binding #ClipboardShare}" Padding="0" VerticalAlignment="Center"/>
          <ToggleSwitch Name="ClipboardShare" OnContent="" OffContent="" IsChecked="True" AutomationProperties.Name="共享剪贴板" VerticalAlignment="Center"/>
        </StackPanel>
        <Border Width="1" Height="20" Background="{DynamicResource DeskRule}" Margin="0,0,6,0" VerticalAlignment="Center"/>
        <Button Name="Observe" AutomationProperties.Name="观察" Classes="tool" Margin="0,0,3,0" IsEnabled="False"><StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Width="16" Height="16" Data="M12 4C6.3 4 2.4 8.2 0.7 12C2.4 15.8 6.3 20 12 20C17.7 20 21.6 15.8 23.3 12C21.6 8.2 17.7 4 12 4ZM12 6C16.3 6 19.6 9.1 21.1 12C19.6 14.9 16.3 18 12 18C7.7 18 4.4 14.9 2.9 12C4.4 9.1 7.7 6 12 6ZM12 8A4 4 0 1 0 12 16A4 4 0 1 0 12 8Z" VerticalAlignment="Center"/><TextBlock Text="观察" VerticalAlignment="Center"/></StackPanel></Button>
        <Button Name="Control" AutomationProperties.Name="控制" Classes="tool" Margin="0,0,8,0" IsEnabled="False"><StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Width="16" Height="16" Data="M4 2L20 13L13.7 14L17 20.4L14 22L10.8 15.6L6.3 20Z" VerticalAlignment="Center"/><TextBlock Text="控制" VerticalAlignment="Center"/></StackPanel></Button>
        <Border Width="1" Height="20" Background="{DynamicResource DeskRule}" Margin="0,0,6,0" VerticalAlignment="Center"/>
        <Button Name="Zoom" Content="100%" Classes="tool" Margin="0,0,3,0"/>
        <Button Name="Fullscreen" Classes="tool" AutomationProperties.Name="全屏" Margin="0,0,3,0"><StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Width="16" Height="16" Data="M3 3H10V5H5V10H3ZM14 3H21V10H19V5H14ZM3 14H5V19H10V21H3ZM19 14H21V21H14V19H19Z" VerticalAlignment="Center"/><TextBlock Name="FullscreenLabel" Text="全屏" VerticalAlignment="Center"/></StackPanel></Button>
        <local:AppearanceButton Classes="tool" Margin="0,0,4,0"/><Button Name="End" AutomationProperties.Name="结束共享" Classes="tool end"><StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Width="16" Height="16" Data="M5 4H19Q20 4 20 5V19Q20 20 19 20H5Q4 20 4 19V5Q4 4 5 4ZM6 6V18H18V6Z" VerticalAlignment="Center"/><TextBlock Text="结束共享" VerticalAlignment="Center"/></StackPanel></Button>
      </WrapPanel>
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9" VerticalAlignment="Center" Margin="0,0,12,0">
        <PathIcon Width="21" Height="21" Data="M2 3H22V17H13V19H17V21H7V19H11V17H2ZM4 5V15H20V5Z" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1">
        <TextBlock Name="NameLabel" TextTrimming="CharacterEllipsis" FontSize="16" FontWeight="SemiBold"/>
        <WrapPanel><TextBlock Name="Mode" Text="准备本机观看组件" Classes="muted"/><TextBlock Name="Resolution" Margin="8,0,0,0" Classes="muted"/><TextBlock Name="Route" Margin="8,0,0,0" Classes="muted"/></WrapPanel>
        </StackPanel>
      </Grid>
    </Grid></Border>
    <Grid Grid.Row="1">
      <ScrollViewer Name="Viewport" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" BringIntoViewOnFocusChange="False">
        <Grid Name="CanvasArea" Background="#142128" Focusable="True" ClipToBounds="True">
      <Image Name="Screen" Stretch="Uniform" IsHitTestVisible="False"/>
        </Grid>
      </ScrollViewer>
      <StackPanel Name="Overlay" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="480">
        <TextBlock Name="Info" Text="正在准备本机观看组件" TextAlignment="Center" TextWrapping="Wrap" Foreground="White"/>
        <Button Name="Retry" HorizontalAlignment="Center" Content="重新打开" IsVisible="False"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
