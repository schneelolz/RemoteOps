<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RemoteOps.Desktop.App">
  <Application.Resources>
    <ResourceDictionary><ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="DeskSurface" Color="#F7F9FA"/>
          <SolidColorBrush x:Key="DeskBar" Color="#F1F5F7"/>
          <SolidColorBrush x:Key="DeskSide" Color="#E9EFF2"/>
          <SolidColorBrush x:Key="DeskInk" Color="#152733"/>
          <SolidColorBrush x:Key="DeskSubtle" Color="#465C68"/>
          <SolidColorBrush x:Key="DeskRule" Color="#CFDCE1"/>
          <SolidColorBrush x:Key="DeskAccent" Color="#076D77"/>
          <SolidColorBrush x:Key="DeskHover" Color="#075B66"/>
          <SolidColorBrush x:Key="DeskDanger" Color="#9B292B"/>
          <SolidColorBrush x:Key="DeskDangerSurface" Color="#FBE4E3"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="DeskSurface" Color="#191E24"/>
          <SolidColorBrush x:Key="DeskBar" Color="#232A31"/>
          <SolidColorBrush x:Key="DeskSide" Color="#1E252C"/>
          <SolidColorBrush x:Key="DeskInk" Color="#F1F6F8"/>
          <SolidColorBrush x:Key="DeskSubtle" Color="#B6C6CF"/>
          <SolidColorBrush x:Key="DeskRule" Color="#38434D"/>
          <SolidColorBrush x:Key="DeskAccent" Color="#10777C"/>
          <SolidColorBrush x:Key="DeskHover" Color="#13696F"/>
          <SolidColorBrush x:Key="DeskDanger" Color="#FFB3AD"/>
          <SolidColorBrush x:Key="DeskDangerSurface" Color="#482D32"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries></ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme/>
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, sans-serif"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Background" Value="{DynamicResource DeskSurface}"/>
      <Setter Property="Foreground" Value="{DynamicResource DeskInk}"/>
    </Style>
    <Style Selector="Button"><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="14,6"/><Setter Property="CornerRadius" Value="5"/></Style>
    <Style Selector="Button.tool"><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="11,4"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource DeskInk}"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource DeskAccent}"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource DeskHover}"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource DeskSubtle}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style Selector="Button.end"><Setter Property="Background" Value="{DynamicResource DeskDangerSurface}"/><Setter Property="Foreground" Value="{DynamicResource DeskDanger}"/></Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="38"/></Style>
    <Style Selector="TextBox[AcceptsReturn=false]"><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style Selector="ListBox#Devices ListBoxItem"><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="12,10"/></Style>
  </Application.Styles>
</Application>
