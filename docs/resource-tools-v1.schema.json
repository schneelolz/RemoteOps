{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RemoteOps 资源清单 v1",
  "type": "object",
  "required": [
    "schema_version",
    "tools"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "tools": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "description",
          "documentation_url",
          "publisher",
          "license",
          "release_notes",
          "capabilities",
          "permissions",
          "limitations",
          "requires_desktop",
          "platforms",
          "package",
          "startup",
          "health_check",
          "timeout_secs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._+-]+$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._+-]+$",
            "not": {
              "const": "latest"
            }
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "documentation_url": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "release_notes": {
            "type": "string",
            "minLength": 1
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requires_desktop": {
            "type": "boolean"
          },
          "platforms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "os",
                "arch",
                "os_versions",
                "status"
              ],
              "properties": {
                "os": {
                  "type": "string",
                  "minLength": 1
                },
                "arch": {
                  "type": "string",
                  "minLength": 1
                },
                "os_versions": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "enum": [
                    "passed",
                    "pending",
                    "unsupported"
                  ]
                },
                "min_windows_build": {
                  "type": "integer",
                  "minimum": 1
                },
                "max_windows_build": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "package": {
            "type": "object",
            "required": [
              "url",
              "format",
              "size",
              "sha256"
            ],
            "properties": {
              "url": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "const": "zip"
              },
              "size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1073741824
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "startup": {
            "type": "object",
            "required": [
              "interface",
              "executable",
              "args"
            ],
            "properties": {
              "interface": {
                "enum": [
                  "stdio_mcp",
                  "agent_browser_cli",
                  "cli"
                ]
              },
              "executable": {
                "type": "string",
                "minLength": 1
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 8192
                },
                "maxItems": 64
              },
              "browser_executable": {
                "type": "string"
              },
              "browser_adapter": {
                "enum": [
                  "none",
                  "playwright",
                  "agent_browser",
                  null
                ],
                "description": "可选显式 STDIO MCP 浏览器适配；需要新版 Agent 能力声明。省略或 null 沿用旧行为；工具中心新增或变更非空浏览器路径的 STDIO MCP 启动配置时必须显式指定 playwright 或 agent_browser。"
              },
              "operations": {
                "type": "array",
                "maxItems": 256,
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "description",
                    "input_schema",
                    "args"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "description": {
                      "type": "string"
                    },
                    "input_schema": {
                      "type": "object"
                    },
                    "args": {
                      "type": "array",
                      "maxItems": 64,
                      "items": {
                        "oneOf": [
                          {
                            "type": "object",
                            "required": [
                              "kind",
                              "value"
                            ],
                            "properties": {
                              "kind": {
                                "const": "literal"
                              },
                              "value": {
                                "type": "string",
                                "maxLength": 8192
                              }
                            }
                          },
                          {
                            "type": "object",
                            "required": [
                              "kind",
                              "name"
                            ],
                            "properties": {
                              "kind": {
                                "const": "parameter"
                              },
                              "name": {
                                "type": "string",
                                "minLength": 1
                              }
                            }
                          }
                        ]
                      }
                    },
                    "result_format": {
                      "enum": [
                        "text",
                        "json"
                      ],
                      "default": "text"
                    },
                    "executable": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "health_check": {
            "type": "object",
            "required": [
              "method",
              "timeout_secs"
            ],
            "properties": {
              "method": {
                "enum": [
                  "tools/list",
                  "version",
                  "schema"
                ]
              },
              "timeout_secs": {
                "type": "integer",
                "minimum": 1,
                "maximum": 120
              }
            }
          },
          "timeout_secs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300
          },
          "documentation": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              },
              "instructions": {
                "type": "string"
              },
              "examples": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "platform_tests": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "object",
              "required": [
                "os",
                "arch",
                "windows_build",
                "desktop",
                "status"
              ],
              "properties": {
                "os": {
                  "type": "string",
                  "maxLength": 32
                },
                "arch": {
                  "type": "string",
                  "maxLength": 32
                },
                "windows_build": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 4294967295
                },
                "desktop": {
                  "type": "boolean"
                },
                "status": {
                  "enum": [
                    "passed",
                    "failed",
                    "pending"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
