# Relay 镜像；默认从当前源码构建。
REMOTEOPS_RELAY_IMAGE=remoteops-relay:0.2.0-preview.5
REMOTEOPS_RELAY_DOCKERFILE=deploy/relay/Dockerfile

# 必须包含 Controller 和 Agent 实际连接的公网域名或 IP。
# 保留容器服务名和回环地址，便于容器内健康检查与本机诊断。
REMOTEOPS_TLS_SANS=relay.example.com,remoteops-relay,localhost,127.0.0.1

# 对外 TLS 端口和仅绑定宿主机回环地址的健康检查端口。
REMOTEOPS_RELAY_PORT=7443
REMOTEOPS_HEALTH_PORT=18080
REMOTEOPS_RELAY_ADMIN_PORT=18081
REMOTEOPS_ADMIN_TOKEN=replace-with-a-random-management-token-at-least-32-bytes
REMOTEOPS_ADMIN_USERNAME=admin
REMOTEOPS_ADMIN_PASSWORD=replace-with-a-long-random-password
REMOTEOPS_ADMIN_COOKIE_SECURE=true
REMOTEOPS_ADMIN_PASSWORD_FORCE_RESET=false

# Relay 运行参数。
REMOTEOPS_RELAY_CONTAINER_NAME=remoteops-relay
REMOTEOPS_RESTART_POLICY=unless-stopped
REMOTEOPS_RELAY_VOLUME_NAME=remoteops-relay-data
REMOTEOPS_LEASE_SECONDS=600
REMOTEOPS_MAX_CONNECTIONS=1024
REMOTEOPS_TLS_HANDSHAKE_TIMEOUT_SECONDS=10

# Human Token 必填。部署时生成高强度随机值，不得提交真实 Token。
REMOTEOPS_HUMAN_CONTROLLER_TOKEN=

# 需要保留现有旧 MCP 时保留原 AI Token（至少32字节，且与Human不同）。
# 管理页“允许旧 Token 客户端接入”默认开启，可关闭以拒绝旧凭据。
# 新版安装器仅支持设置码/设置文件；无旧客户端时可留空或移除。
REMOTEOPS_AI_CONTROLLER_TOKEN=

# Human Controller 和 AI Controller 必须共享同一个 Owner UUID；两者属于同一控制者。
REMOTEOPS_CONTROLLER_OWNER_ID=
